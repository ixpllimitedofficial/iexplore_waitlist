              </TableCell>
              <TableCell>{vendor.location || "N/A"}</TableCell>
              <TableCell>{vendor.email}</TableCell>
              <TableCell>
                <Badge
                  className={`${
                    vendor.is_active
                      ? "bg-[#00b69b48] text-[#00B69B]"
