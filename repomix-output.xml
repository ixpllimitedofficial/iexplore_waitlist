      </div>

      <div className="bg-[#4D4D4D66] bg-opacity-40 p-3 rounded-2xl">
        <div className="flex justify-between my-5 gap-3">
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            className="w-[50%]"
