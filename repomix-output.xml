              <p className="font-bold text-gold-500 text-lg">4.5</p>
            </div>
          </div>

          <p className="pl-2 text-sm md:text-lg text-[#D1D1D1]">
            {spot?.location}
          </p>

          <div className="flex items-center px-2 text-gold-500 text-sm md:text-lg gap-3">
