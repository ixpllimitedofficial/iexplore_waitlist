          </div>
        </div>

        <div className="mt-5 flex flex-col gap-2">
          <p className=" font-bold text-2xl">Contact</p>
          <p className="text-lg col-span-2">Website: www.maxxabeachbar.com</p>
          <p className="text-lg col-span-2">Call: +234 901 234 5678</p>
